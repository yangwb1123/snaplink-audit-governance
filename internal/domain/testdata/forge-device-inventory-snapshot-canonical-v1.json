    },
    {
      "name": "invalid_snapshot_id_rejected",
      "input": {
        "snapshot_id": "snapshot/5",
        "observed_at_ms": 200004,
        "owner": {
          "issuer": "https://id.example",
          "subject": "user-1",
          "tenant_id": "tenant-1"
        },
        "rows": []
      },
      "expected": {
        "error": "invalid_snapshot_id"
      }
    },
    {
      "name": "zero_observed_time_rejected",
      "input": {
        "snapshot_id": "snapshot-6",
        "observed_at_ms": 0,
        "owner": {
          "issuer": "https://id.example",
          "subject": "user-1",
