{
  "name": "@snaplink/audit-governance-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "check": "vitest run && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && eslint src vite.config.ts && vite build"
  },
  "dependencies": {
    "@iris-ui-kit/core": "0.2.3",
    "@iris-ui-kit/svelte": "0.2.3",
    "jose": "^6.2.3",
    "svelte": "5.46.4"
  },
  "pnpm": {
    "overrides": {
      "@iris-ui-kit/core": "0.2.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^20.16.10",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.13.0",
    "happy-dom": "20.14.5",
    "svelte-check": "^4.3.4",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
