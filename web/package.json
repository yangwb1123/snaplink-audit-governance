{
  "name": "@snaplink/audit-governance-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "check": "vitest run && tsc --noEmit && eslint src vite.config.ts && vite build"
  },
  "dependencies": {
    "@iris-ui-kit/core": "0.2.1",
    "@iris-ui-kit/icons": "0.2.0",
    "@iris-ui-kit/react": "0.2.3",
    "@iris-ui-kit/skins": "0.1.1",
    "@iris-ui-kit/theme": "0.3.0",
    "@iris-ui-kit/tokens": "0.3.0",
    "jose": "^6.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "globals": "^15.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "@iris-ui-kit/react>@iris-ui-kit/core": "0.2.1",
      "@iris-ui-kit/react>@iris-ui-kit/icons": "0.2.0",
      "@iris-ui-kit/react>@iris-ui-kit/skins": "0.1.1",
      "@iris-ui-kit/react>@iris-ui-kit/theme": "0.3.0",
      "@iris-ui-kit/react>@iris-ui-kit/tokens": "0.3.0"
    },
    "packageExtensions": {
      "@iris-ui-kit/react@0.2.3": {
        "dependencies": {
          "@iris-ui-kit/core": "0.2.1",
          "@iris-ui-kit/icons": "0.2.0",
          "@iris-ui-kit/skins": "0.1.1",
          "@iris-ui-kit/theme": "0.3.0",
          "@iris-ui-kit/tokens": "0.3.0"
        }
      }
    }
  }
}
